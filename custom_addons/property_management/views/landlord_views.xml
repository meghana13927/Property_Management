<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_property_landlord_list" model="ir.ui.view">
        <field name="name">property.landlord.list</field>
        <field name="model">property.landlord</field>

        <field name="arch" type="xml">
            <list string="Landlords">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="property_count"/>
            </list>
        </field>
    </record>


    <record id="view_property_landlord_form" model="ir.ui.view">
        <field name="name">property.landlord.form</field>
        <field name="model">property.landlord</field>

        <field name="arch" type="xml">
            <form string="Landlord">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Landlord Name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Contact Information">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>

                        <group string="Property Summary">
                            <field name="property_count" readonly="1"/>
                        </group>

                    </group>

                    <group string="Address">
                        <field name="address"/>
                    </group>

                    <notebook>

                        <page string="Properties">

                            <field name="property_ids">

                                <list>
                                    <field name="name"/>
                                    <field name="property_type"/>
                                    <field name="tenant_count"/>
                                    <field name="status"/>
                                </list>

                            </field>

                        </page>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <record id="action_property_landlord" model="ir.actions.act_window">
        <field name="name">Landlords</field>
        <field name="res_model">property.landlord</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="menu_property_landlords"
        name="Landlords"
        parent="menu_property_management_root"
        action="action_property_landlord"
        sequence="30"
    />

</odoo>