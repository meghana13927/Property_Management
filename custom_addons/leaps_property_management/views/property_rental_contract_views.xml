<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ==========================================================
         LIST VIEW
    ========================================================== -->

    <record id="view_rental_contract_list" model="ir.ui.view">

        <field name="name">property.rental.contract.list</field>

        <field name="model">property.rental.contract</field>

        <field name="arch" type="xml">

            <list
                string="Rental Contracts"
                decoration-info="state == 'active'"
                decoration-muted="state in ['expired','terminated']"
            >

                <field name="name"/>

                <field name="unit_id"/>

                <field name="tenant_id"/>

                <field name="date_start"/>

                <field name="date_end"/>

                <field name="payment_term"/>

                <field name="rent_amount"/>

                <field name="security_deposit"/>

                <field name="invoice_count"/>

                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'active'"
                    decoration-warning="state == 'draft'"
                    decoration-muted="state in ['expired','terminated']"
                />

            </list>

        </field>

    </record>


    <!-- ==========================================================
         FORM VIEW
    ========================================================== -->

    <record id="view_rental_contract_form" model="ir.ui.view">

        <field name="name">property.rental.contract.form</field>

        <field name="model">property.rental.contract</field>

        <field name="arch" type="xml">

            <form string="Rental Contract">

                <header>

                    <button
                        name="action_activate"
                        string="Activate"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_generate_invoices"
                        string="Generate Invoices"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'active'"
                    />

                    <button
                        name="action_terminate"
                        string="Terminate Contract"
                        type="object"
                        invisible="state not in ['active']"
                        confirm="Are you sure you want to terminate this contract?"
                    />

                    <button
                        name="action_expire"
                        string="Mark as Expired"
                        type="object"
                        invisible="state not in ['active']"
                    />

                    <button
                        name="action_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ['terminated','expired']"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,active,expired"
                    />

                </header>


                <sheet>

                    <!-- SMART BUTTONS -->

                    <div class="oe_button_box" name="button_box">

                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_invoices"
                            icon="fa-usd"
                        >

                            <field
                                name="invoice_count"
                                widget="statinfo"
                                string="Invoices"
                            />

                        </button>


                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_commissions"
                            icon="fa-percent"
                        >

                            <field
                                name="commission_count"
                                widget="statinfo"
                                string="Commissions"
                            />

                        </button>

                    </div>


                    <!-- TITLE -->

                    <div class="oe_title">

                        <h1>
                            <field name="name"/>
                        </h1>

                    </div>


                    <!-- CONTRACT DETAILS -->

                    <group>

                        <group string="Contract Details">

                            <field name="unit_id"/>

                            <field name="tenant_id"/>

                            <field
                                name="owner_id"
                                readonly="1"
                            />

                        </group>


                        <group string="Period and Terms">

                            <field name="date_start"/>

                            <field name="date_end"/>

                            <field name="payment_term"/>

                        </group>

                    </group>


                    <!-- FINANCIAL INFORMATION -->

                    <group>

                        <group string="Financial Information">

                            <field
                                name="currency_id"
                                invisible="1"
                            />

                            <field name="rent_amount"/>

                            <field name="security_deposit"/>

                            <field name="admin_fee"/>

                            <field
                                name="total_invoiced"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <!-- NOTEBOOK -->

                    <notebook>


                        <!-- TERMS AND NOTES -->

                        <page
                            string="Terms and Notes"
                            name="notes_page"
                        >

                            <field
                                name="notes"
                                placeholder="Contract terms and special conditions..."
                            />

                        </page>


                        <!-- REGA / SAUDI ARABIA -->

                        <page
                            string="🇸🇦 REGA / Saudi Arabia"
                            name="rega_page"
                        >

                            <!-- Information Banner -->

                            <div
                                class="alert alert-info mb-3"
                                role="alert"
                            >

                                <strong>
                                    🇸🇦 Real Estate General Authority (REGA) — Saudi Arabia
                                </strong>

                                <br/>

                                Leasing:
                                <strong>2.5%</strong>
                                of first-year rent
                                (paid by tenant) |

                                Management:
                                <strong>5–8%</strong>
                                Residential /
                                <strong>7–12%</strong>
                                Commercial |

                                VAT:
                                <strong>15%</strong>
                                for VAT-registered taxpayers |

                                Ejar:
                                All residential rental contracts must be registered

                            </div>


                            <!-- EJAR + LEASING COMMISSION -->

                            <group>


                                <!-- EJAR -->

                                <group string="Ejar Platform">

                                    <field name="is_renewal"/>

                                    <field name="ejar_registration_no"/>

                                    <field
                                        name="ejar_fee"
                                        invisible="not is_renewal"
                                        help="SAR 125 — residential platform fee paid by the landlord"
                                    />

                                    <field
                                        name="renewal_admin_fee"
                                        invisible="not is_renewal"
                                        help="Fixed administrative fee of SAR 200–500. This replaces the 2.5% commission on renewal."
                                    />

                                </group>


                                <!-- LEASING COMMISSION -->

                                <group string="Leasing Commission (One-Time)">

                                    <field
                                        name="leasing_commission_rate"
                                        invisible="is_renewal"
                                        help="REGA standard: 2.5% of total first-year rent"
                                    />

                                    <field
                                        name="leasing_commission_amount"
                                        readonly="1"
                                        invisible="is_renewal"
                                    />

                                    <field
                                        name="tenant_pays_commission"
                                        invisible="is_renewal"
                                    />

                                    <field name="vat_applicable"/>

                                    <field
                                        name="vat_amount"
                                        readonly="1"
                                        invisible="not vat_applicable"
                                    />

                                </group>

                            </group>


                            <!-- MANAGEMENT + AGENT GUIDANCE -->

                            <group>


                                <!-- MANAGEMENT FEE -->

                                <group string="Property Management Fee (Annual)">

                                    <field name="management_fee_type"/>

                                    <field
                                        name="management_fee_rate"
                                        help="Residential: 5–8% | Commercial: 7–12%"
                                    />

                                    <field
                                        name="management_fee_amount"
                                        readonly="1"
                                    />

                                </group>


                                <!-- AGENT COMPENSATION -->

                                <group string="Agent Compensation Guide">

                                    <div
                                        style="background:#f8f9fa;
                                               padding:12px;
                                               border-radius:6px;
                                               border:1px solid #dee2e6;"
                                    >

                                        <table
                                            style="width:100%;
                                                   font-size:0.85em;
                                                   border-collapse:collapse;"
                                        >

                                            <tr>
                                                <td style="padding:4px 0;color:#666;">
                                                    Base Salary (Market):
                                                </td>
                                                <td style="font-weight:700;">
                                                    SAR 4,000 – 8,000
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:4px 0;color:#666;">
                                                    Leasing Commission:
                                                </td>
                                                <td style="font-weight:700;">
                                                    25% – 30% of the 2.5%
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:4px 0;color:#666;">
                                                    Collection Incentive:
                                                </td>
                                                <td style="font-weight:700;">
                                                    1% – 2% (bad debt recovery)
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:4px 0;color:#666;">
                                                    KPI Incentive:
                                                </td>
                                                <td style="font-weight:700;">
                                                    If occupancy exceeds 95%
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:4px 0;color:#666;">
                                                    FAL License:
                                                </td>
                                                <td style="font-weight:700;color:#dc3545;">
                                                    Required by REGA
                                                </td>
                                            </tr>

                                        </table>

                                    </div>

                                </group>

                            </group>


                            <!-- COMMISSION RECORDS -->

                            <group string="Commission Records">

                                <field
                                    name="commission_ids"
                                    nolabel="1"
                                >

                                    <list editable="bottom">

                                        <field
                                            name="name"
                                            readonly="1"
                                        />

                                        <field name="commission_type"/>

                                        <field name="agent_id"/>

                                        <field
                                            name="fal_license_no"
                                            readonly="1"
                                        />

                                        <field
                                            name="company_commission_amount"
                                            readonly="1"
                                            string="Company Commission"
                                        />

                                        <field
                                            name="agent_amount"
                                            readonly="1"
                                        />

                                        <field
                                            name="vat_amount"
                                            readonly="1"
                                        />

                                        <field
                                            name="total_with_vat"
                                            readonly="1"
                                        />

                                        <field
                                            name="state"
                                            widget="badge"
                                        />

                                        <field
                                            name="currency_id"
                                            column_invisible="1"
                                        />

                                    </list>

                                </field>


                                <div class="mt-2">

                                    <button
                                        name="action_create_leasing_commission"
                                        string="+ Create Leasing Commission"
                                        type="object"
                                        class="btn btn-sm btn-outline-primary"
                                        invisible="is_renewal"
                                    />

                                </div>

                            </group>

                        </page>

                    </notebook>

                </sheet>


                <chatter/>

            </form>

        </field>

    </record>


    <!-- ==========================================================
         SEARCH VIEW
    ========================================================== -->

    <record id="view_rental_contract_search" model="ir.ui.view">

        <field name="name">property.rental.contract.search</field>

        <field name="model">property.rental.contract</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="unit_id"/>

                <field name="tenant_id"/>


                <filter
                    string="Active"
                    name="active"
                    domain="[('state','=','active')]"
                />

                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state','=','draft')]"
                />

                <filter
                    string="Expired"
                    name="expired"
                    domain="[('state','=','expired')]"
                />


                <group>

                    <filter
                        string="Status"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />

                    <filter
                        string="Payment Terms"
                        name="group_payment_term"
                        context="{'group_by': 'payment_term'}"
                    />

                </group>

            </search>

        </field>

    </record>


    <!-- ==========================================================
         ACTION
    ========================================================== -->

    <record id="action_rental_contract" model="ir.actions.act_window">

        <field name="name">Rental Contracts</field>

        <field name="res_model">
            property.rental.contract
        </field>

        <field name="view_mode">
            list,form,graph,pivot
        </field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first rental contract
            </p>

        </field>

    </record>


    <!-- ==========================================================
         GRAPH VIEW
    ========================================================== -->

    <record id="view_rental_contract_graph" model="ir.ui.view">

        <field name="name">property.rental.contract.graph</field>

        <field name="model">property.rental.contract</field>

        <field name="arch" type="xml">

            <graph
                string="Rental Revenue"
                type="bar"
                sample="1"
            >

                <field
                    name="date_start"
                    interval="month"
                    type="row"
                />

                <field
                    name="rent_amount"
                    type="measure"
                />

            </graph>

        </field>

    </record>


    <!-- ==========================================================
         PIVOT VIEW
    ========================================================== -->

    <record id="view_rental_contract_pivot" model="ir.ui.view">

        <field name="name">property.rental.contract.pivot</field>

        <field name="model">property.rental.contract</field>

        <field name="arch" type="xml">

            <pivot
                string="Rental Analysis"
                sample="1"
            >

                <field
                    name="payment_term"
                    type="row"
                />

                <field
                    name="state"
                    type="col"
                />

                <field
                    name="rent_amount"
                    type="measure"
                />

            </pivot>

        </field>

    </record>

</odoo>