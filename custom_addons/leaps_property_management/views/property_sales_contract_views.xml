<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_contract_list" model="ir.ui.view">
        <field name="name">property.sales.contract.list</field>
        <field name="model">property.sales.contract</field>
        <field name="arch" type="xml">

            <list
                string="Sales Contracts"
                decoration-success="state == 'completed'"
                decoration-info="state in ['booked','spa']"
                decoration-muted="state == 'cancelled'"
            >

                <field name="name"/>
                <field name="unit_id"/>
                <field name="buyer_id"/>
                <field name="date_contract"/>
                <field name="agreed_price"/>
                <field name="booking_amount"/>
                <field name="total_paid"/>
                <field name="balance_due"/>

                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'completed'"
                    decoration-info="state in ['booked','spa']"
                    decoration-warning="state == 'draft'"
                    decoration-danger="state == 'cancelled'"
                />

            </list>

        </field>
    </record>


    <record id="view_sales_contract_form" model="ir.ui.view">
        <field name="name">property.sales.contract.form</field>
        <field name="model">property.sales.contract</field>
        <field name="arch" type="xml">

            <form string="Sales Contract">

                <header>

                    <button
                        name="action_book"
                        string="Confirm Booking"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_sign_spa"
                        string="Sign Sales Agreement"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'booked'"
                    />

                    <button
                        name="action_complete"
                        string="Mark as Completed"
                        type="object"
                        class="btn-success"
                        invisible="state != 'spa'"
                    />

                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state in ['completed','cancelled']"
                        confirm="Are you sure you want to cancel this sales contract?"
                    />

                    <button
                        name="action_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ['cancelled']"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,booked,spa,completed"
                    />

                </header>


                <sheet>

                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">

                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_invoices"
                            icon="fa-usd"
                        >
                            <field
                                name="invoice_count"
                                widget="statinfo"
                                string="Invoices"
                            />
                        </button>

                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_commissions"
                            icon="fa-money"
                        >
                            <field
                                name="commission_count"
                                widget="statinfo"
                                string="Commissions"
                            />
                        </button>

                    </div>


                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>


                    <!-- Property and Parties -->
                    <group>

                        <group string="Property and Parties">

                            <field name="unit_id"/>
                            <field name="buyer_id"/>
                            <field name="seller_id" readonly="1"/>

                        </group>


                        <group string="Dates">

                            <field name="date_contract"/>
                            <field name="date_completion"/>

                        </group>

                    </group>


                    <!-- Pricing and Fees -->
                    <group>

                        <group string="Pricing">

                            <field name="currency_id" invisible="1"/>

                            <field name="sale_price" readonly="1"/>

                            <field name="agreed_price"/>

                            <field name="booking_amount"/>

                            <field name="down_payment"/>

                        </group>


                        <group string="Fees and Costs">

                            <field name="admin_fee"/>

                            <field name="stamp_duty"/>

                            <field name="registration_fee"/>

                            <field name="total_paid" readonly="1"/>

                            <field name="balance_due" readonly="1"/>

                        </group>

                    </group>


                    <notebook>


                        <!-- Payment Plan -->
                        <page string="Payment Plan">

                            <field name="payment_plan_ids">

                                <list editable="bottom">

                                    <field name="name"/>

                                    <field name="due_date"/>

                                    <field name="amount"/>

                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-success="state == 'paid'"
                                        decoration-danger="state == 'overdue'"
                                    />

                                    <field name="notes"/>

                                </list>

                            </field>

                        </page>


                        <!-- Commissions -->
                        <page
                            string="Commissions"
                            name="commissions_page"
                        >

                            <field name="commission_ids">

                                <list>

                                    <field name="name"/>

                                    <field name="commission_type"/>

                                    <field
                                        name="company_commission_rate"
                                        string="Company Rate %"
                                    />

                                    <field
                                        name="company_commission_amount"
                                        string="Company Commission"
                                    />

                                    <field
                                        name="agent_amount"
                                        string="Agent Commission"
                                    />

                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-success="state == 'paid'"
                                        decoration-info="state == 'approved'"
                                        decoration-warning="state == 'invoiced'"
                                    />

                                </list>

                            </field>

                        </page>


                        <!-- Terms and Notes -->
                        <page string="Terms and Notes">

                            <field
                                name="notes"
                                placeholder="Contract terms and special conditions..."
                            />

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <record id="view_sales_contract_search" model="ir.ui.view">

        <field name="name">property.sales.contract.search</field>

        <field name="model">property.sales.contract</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="unit_id"/>

                <field name="buyer_id"/>


                <filter
                    string="Draft"
                    name="filter_draft"
                    domain="[('state','=','draft')]"
                />

                <filter
                    string="Booked"
                    name="filter_booked"
                    domain="[('state','=','booked')]"
                />

                <filter
                    string="Sales Agreement Signed"
                    name="filter_spa"
                    domain="[('state','=','spa')]"
                />

                <filter
                    string="Completed"
                    name="filter_completed"
                    domain="[('state','=','completed')]"
                />


                <group>

                    <filter
                        string="Status"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />

                </group>

            </search>

        </field>
    </record>


    <record id="action_sales_contract" model="ir.actions.act_window">

        <field name="name">Sales Contracts</field>

        <field name="res_model">property.sales.contract</field>

        <field name="view_mode">list,form</field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first sales contract
            </p>

        </field>

    </record>

</odoo>