<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Amenity List View -->
    <record id="view_property_amenity_list" model="ir.ui.view">
        <field name="name">property.amenity.list</field>
        <field name="model">property.amenity</field>

        <field name="arch" type="xml">
            <list string="Amenities" editable="bottom">
                <field name="name"/>
                <field name="icon"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Amenity Form View -->
    <record id="view_property_amenity_form" model="ir.ui.view">
        <field name="name">property.amenity.form</field>
        <field name="model">property.amenity</field>

        <field name="arch" type="xml">
            <form string="Amenity">

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="icon"/>
                        <field name="active"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Amenity Action -->
    <record id="action_property_amenity" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">property.amenity</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>